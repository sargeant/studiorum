# 5e2pdf Development Environment Variables
#
# This file contains environment variables for 5e2pdf development.
# Load with: uv run --env-file .env.dev -- <command>
# Or use the dev alias: uvdev <command>

# Debug Environment Variables
DND5E_DISABLE_TAG_FALLBACK=1
DND5E_DEBUG_ENTRY_PROCESSING=0
# NOTE: Strict entry processing for development quality assurance
# Disable with DND5E_STRICT_ENTRY_PROCESSING=0 if you need flexible processing
DND5E_STRICT_ENTRY_PROCESSING=0

# Validation strictness for tests - use lenient to suppress validation warnings
VALIDATION_STRICTNESS=lenient

# Development Logging
# DND5E_LOGGING__LEVEL=DEBUG

# UV-specific development settings
UV_COMPILE_BYTECODE=0
# RUST_LOG=debug

# Development data paths (uncomment and adjust if needed)
# DND5E_PATHS__DATA_PATH=./test-data
# DND5E_PATHS__OUTPUT_PATH=./debug-output

# Python development settings
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
