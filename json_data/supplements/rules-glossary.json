			"name": "Rules Glossary",
			"page": 360,
			"id": "a8f",
			"entries": [
				{
					"type": "section",
					"name": "Glossary Conventions",
					"page": 360,
					"id": "a90",
					"entries": [
						"The glossary uses the following conventions:",
						{
							"type": "list",
							"style": "list-hang-notitle",
							"items": [
								{
									"type": "item",
									"name": "Tags in Brackets",
									"entry": "Some entries have a tag in brackets after the entry's name, as in \"Attack [Action].\" A tag\u2014Action, Area of Effect, Attitude, Condition, or Hazard\u2014indicates that a rule is part of a family of rules. The tags also have glossary entries."
								},
								{
									"type": "item",
									"name": "\"You",
									"entry": "\" The game's rules\u2014in this glossary and elsewhere\u2014often talk about something happening to you in the game world. That \"you\" refers to the creature or object that the rule applies to in a particular moment of play. For example, the \"you\" in the {@condition Prone|XPHB} condition is a creature that currently has that condition."
								},
								{
									"type": "item",
									"name": "\"See Also",
									"entry": "\" Some glossary entries include a See also section that points to other entries in the glossary, to chapters in this book, or both."
								},
								{
									"type": "item",
									"name": "No Obsolete Terms",
									"entry": "The glossary contains definitions of current rules terms only. If you're looking for a term from an earlier version of the fifth edition rules, consult the index."
								},
								{
									"type": "item",
									"name": "Abbreviations",
									"entry": "The abbreviations listed below appear in this glossary and elsewhere in the rules."
								}
							]
						},
