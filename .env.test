# studiorum Test Environment Variables
#
# This file contains environment variables for running tests.
# Load with: uv run --env-file .env.test -- pytest
# Or use the test alias: uvtest <command>

# UV test settings
UV_COMPILE_BYTECODE=0
UV_TEST_NO_HTTP_RETRY_DELAY=true

# Python test settings
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
PYTHONPATH=src
