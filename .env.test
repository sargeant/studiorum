# 5e2pdf Test Environment Variables
#
# This file contains environment variables for running tests.
# Load with: uv run --env-file .env.test -- pytest
# Or use the test alias: uvtest <command>

# Test-specific debugging (less verbose than dev)
DND5E_DISABLE_TAG_FALLBACK=1
# NOTE: Strict entry processing disabled for unit tests to allow edge case testing
# Use DND5E_STRICT_ENTRY_PROCESSING=1 for specific quality assurance tests
# DND5E_STRICT_ENTRY_PROCESSING=0

# Test logging (less verbose)
DND5E_LOGGING__LEVEL=WARNING

# UV test settings
UV_COMPILE_BYTECODE=0
UV_TEST_NO_HTTP_RETRY_DELAY=true

# Python test settings
PYTHONDONTWRITEBYTECODE=1
PYTHONUNBUFFERED=1
PYTHONPATH=src
