        },
        "width": 742,
        "height": 959
      },
      "entries": [
        "Every magic item you wear or carry disintegrates. Artifacts in your possession aren't destroyed but do vanish."
      ]
    },
    {
      "name": "The Fates",
      "source": "SRD",
      "set": "Deck of Many Things",
      "page": 162,
      "srd": true,
      "face": {
        "type": "image",
        "href": {
