        "height": 959
      },
      "entries": [
        "You are granted the ability to cast the {@spell wish} spell {@dice 1d3} times."
      ]
    },
    {
      "name": "Rogue",
      "source": "SRD",
      "set": "Deck of Many Things",
      "page": 162,
      "srd": true,
      "face": {
        "type": "image",
