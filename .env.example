# D&D 5e PDF Generator Environment Configuration
# Copy this file to .env.dev or .env.test and configure as needed

# ==============================================================================
# LOGFIRE OBSERVABILITY (Optional)
# ==============================================================================

# Pydantic Logfire token for cloud observability and telemetry
# Required for: --observability, --telemetry, --logfire-dev CLI options
#
# Get your token from: https://logfire.pydantic.dev/
# 1. Sign up/login to Logfire
# 2. Create a new project
# 3. Copy the project token
#
# SECURITY: Never commit actual tokens to git
LOGFIRE_TOKEN=your_logfire_token_here

# ==============================================================================
# DEVELOPMENT SETTINGS
# ==============================================================================

# Enable debug logging by default (true/false)
# Used when CLI --debug option is not explicitly provided
STUDIORUM_DEBUG=false

# Default deployment environment
# Used when CLI --environment option is not explicitly provided
# Values: local, dev, staging, prod
STUDIORUM_ENVIRONMENT=local

# Default logging level for console output
# Values: DEBUG, INFO, WARNING, ERROR
STUDIORUM_LOG_LEVEL=INFO

# ==============================================================================
# DATA SOURCE CONFIGURATION
# ==============================================================================

# Path to 5etools data directory
# Should contain JSON files from 5etools project
STUDIORUM_DATA_DIR=./5etools-data

# Custom content sources (comma-separated paths)
STUDIORUM_CUSTOM_SOURCES=

# Enable content caching for faster repeated access
STUDIORUM_ENABLE_CACHE=true

# Cache directory location
STUDIORUM_CACHE_DIR=~/.studiorum/cache

# ==============================================================================
# LATEX COMPILATION SETTINGS
# ==============================================================================

# Path to LaTeX template directory
# Should contain DND-5e-LaTeX-Template
LATEX_TEMPLATE_DIR=../DND-5e-LaTeX-Template

# LaTeX compiler to use (pdflatex, xelatex, lualatex)
LATEX_COMPILER=xelatex

# Enable LaTeX compiler output (true/false)
LATEX_VERBOSE=false

# LaTeX compilation timeout in seconds
LATEX_TIMEOUT=300

# ==============================================================================
# MCP SERVER CONFIGURATION
# ==============================================================================

# Default MCP server host for HTTP transport
MCP_HOST=localhost

# Default MCP server port for HTTP transport
MCP_PORT=8080

# Enable MCP protocol message debugging by default
MCP_DEBUG_PROTOCOL=false

# Default location for MCP debug logs
# Will use ~/.studiorum/logs/ if not specified
MCP_DEBUG_LOG_DIR=

# ==============================================================================
# TESTING CONFIGURATION
# ==============================================================================

# Test data directory (used by test-config.yaml)
TEST_DATA_DIR=./test-data

# Enable parallel test execution
TEST_PARALLEL=true

# Test coverage threshold percentage
TEST_COVERAGE_MIN=90

# ==============================================================================
# USAGE EXAMPLES
# ==============================================================================

# Example development setup:
# STUDIORUM_DEBUG=true
# STUDIORUM_ENVIRONMENT=dev
# LOGFIRE_TOKEN=logfire_live_abc123...
# STUDIORUM_DATA_DIR=../5etools-src/data

# Example MCP debugging setup:
# STUDIORUM_DEBUG=true
# MCP_DEBUG_PROTOCOL=true
# LOGFIRE_TOKEN=logfire_live_abc123...

# Example production setup:
# STUDIORUM_DEBUG=false
# STUDIORUM_ENVIRONMENT=prod
# LOGFIRE_TOKEN=logfire_live_prod456...
# STUDIORUM_ENABLE_CACHE=true
