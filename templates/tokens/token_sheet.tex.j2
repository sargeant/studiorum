{# Token sheet template for D&D 5e creatures #}
\documentclass[{{ paper_size }}paper]{article}
\usepackage[margin={{ margins }}in]{geometry}
\usepackage{graphicx}
\usepackage{tikz}
\usepackage{xcolor}
\usepackage{multicol}
\usepackage{calc}
\usepackage{ifthen}
\usepackage{contour}

% Disable page numbers
\pagestyle{empty}

% Grid size constants (1 inch = 1 D&D grid square)
\newlength{\gridsize}
\setlength{\gridsize}{1in}

% Token size definitions
\newlength{\tinysize}\setlength{\tinysize}{0.5\gridsize}
\newlength{\smallsize}\setlength{\smallsize}{0.75\gridsize}
\newlength{\mediumsize}\setlength{\mediumsize}{1\gridsize}
\newlength{\largesize}\setlength{\largesize}{2\gridsize}
\newlength{\hugesize}\setlength{\hugesize}{3\gridsize}
\newlength{\gargantuansize}\setlength{\gargantuansize}{4\gridsize}

% Token counter for numbering
\newcounter{tokencount}

% Token macro
\newcommand{\StudiorumToken}[4][medium]{%
  % #1 = size (tiny/small/medium/large/huge/gargantuan)
  % #2 = image path
  % #3 = count
  % #4 = creature name
  \setcounter{tokencount}{0}%
  \whiledo{\value{tokencount} < #3}{%
    \stepcounter{tokencount}%
    \begin{tikzpicture}
      % Determine size
      \pgfmathsetmacro{\tokensize}{%
        ifthenelse(equal("#1","tiny"), 0.5,
        ifthenelse(equal("#1","small"), 0.75,
        ifthenelse(equal("#1","medium"), 1,
        ifthenelse(equal("#1","large"), 2,
        ifthenelse(equal("#1","huge"), 3,
        ifthenelse(equal("#1","gargantuan"), 4, 1))))))%
      }

      % Only render if image path is provided
      \ifthenelse{\equal{#2}{}}{%
        % No image - render placeholder circle
        \draw[line width=1pt, gray] (0,0) circle (\tokensize*0.5in);
        \node[align=center, font=\sffamily\small] at (0,0) {#4};
      }{%
        % Render image token
        \begin{scope}
          \clip (0,0) circle (\tokensize*0.5in);
          \node[inner sep=0pt] at (0,0) {%
            \includegraphics[width=\tokensize in]{#2}%
          };
        \end{scope}

        % Add border
        \draw[line width=0.5pt] (0,0) circle (\tokensize*0.5in);
      }

      % Add number if count > 1
      \ifnum#3>1
        \node[
          fill=black,
          text=white,
          circle,
          inner sep=1pt,
          font=\sffamily\bfseries\scriptsize,
          minimum size=0.2in
        ] at (0.35*\tokensize in, -0.35*\tokensize in) {%
          \contour{black}{\textcolor{white}{\thetokencount}}%
        };
      \fi

      % Add cutting guides for small tokens
      \ifthenelse{\lengthtest{\tokensize in < 1in}}{%
        \draw[gray, dashed, very thin]
          (0,0) circle (0.5in);  % 1" guide circle
      }{}
    \end{tikzpicture}%
    \hspace{0.1in}%
  }%
}

\begin{document}
\pagestyle{empty}

{% for size, tokens in tokens_by_size.items() %}
\section*{{ "{{" }}{{ size|title }} Creatures{{ "}}" }}

{% set columns = column_config[size] %}
{% if columns > 1 %}
\begin{multicols}{{ "{{" }}{{ columns }}{{ "}}" }}
{% endif %}

{% for token in tokens %}
\StudiorumToken[{{ size }}]{{ "{{" }}{{ token.image_path or '' }}{{ "}}" }}{{ "{{" }}{{ token.count }}{{ "}}" }}{{ "{{" }}{{ token.creature_name }}{{ "}}" }}
{% if not loop.last %}\par\vspace{0.1in}{% endif %}
{% endfor %}

{% if columns > 1 %}
\end{multicols}
{% endif %}

{% if not loop.last %}\clearpage{% endif %}
{% endfor %}

\end{document}
