% DND Book template for D&D 5e sourcebooks using DND-5e-LaTeX-Template
% Renders book chapters and content with DND template environments

<@ extends "base.tex.j2" @>

<@ block document_packages @>
<# super() #>

% Additional packages for DND book layout
\usepackage{multicol}
\usepackage{wrapfig}
\usepackage{tikz}
\usepackage{tcolorbox}
<@ endblock @>

<@ block document_config @>
<# super() #>

% DND Book-specific configuration
\setlength{\columnsep}{1cm}
\setlength{\columnseprule}{0.1pt}

% Configure section numbering depth for books
<@ if metadata and metadata.numbering_depth @>
\setcounter{secnumdepth}{<# metadata.numbering_depth #>}
<@ endif @>
<@ endblock @>

<@ block document_body @>
% Book content with DND template environments
<@ if chapters @>
% DEBUG: Found <# chapters | length #> chapters
<@ for chapter in chapters @>

<@ if chapter.number @>
\chapter{<# chapter.number #>: <# chapter.name | latex_escape #>}
<@ else @>
\chapter{<# chapter.name | latex_escape #>}
<@ endif @>

% DEBUG: Chapter has <# chapter.entries | length if chapter.entries else 0 #> entries
<@ if chapter.entries @>
<@ for entry in chapter.entries @>
<# entry #>

<@ endfor @>
<@ else @>
% DEBUG: No entries found for this chapter
<@ endif @>

<@ endfor @>
<@ else @>
% Fallback content if no chapters
<@ if name @>
\chapter{<# name | latex_escape #>}
<@ endif @>

% Placeholder for book content
This book content has been processed by the DND template renderer.

<@ if source @>
\vspace{1em}
\textit{Source: <# source | latex_escape #>}
<@ endif @>

<@ if authors @>
\vspace{0.5em}
\textit{By <# authors | latex_escape #>}
<@ endif @>

<@ endif @>
<@ endblock @>
