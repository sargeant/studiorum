% Bestiary template for D&D 5e creatures with grouping support
% Uses dndbook document class with structured creature organization

<@ extends "base.tex.j2" @>
<@ from "_creature_render_block.tex.j2" import render_creature @>

<@ block document_packages @>
<# super() #>

% Additional packages for bestiary layout
\usepackage{multicol}
\usepackage{enumitem}
\usepackage{tcolorbox}
\usepackage{titlesec}

% Enhanced list environments for creature details
\tcbuselibrary{breakable}

% Float management for large bestiaries
\usepackage{afterpage}
\usepackage{placeins}
<@ endblock @>

<@ block document_config @>
<# super() #>

% Enhanced section styling for bestiary
% DND-5e-LaTeX-Template provides all styling automatically

% Configure for bestiary structure
\setcounter{secnumdepth}{0}  % No section numbers for cleaner look
\setcounter{tocdepth}{2}     % Include subsections in table of contents
<@ endblock @>

<@ block table_of_contents @>
<@ if show_creature_table_of_contents @>
\tableofcontents
\clearpage
<@ endif @>
<@ endblock @>

<@ block document_structure @>
<#-- Bestiary introduction with summary --#>
<@ if creature_count > 0 @>
\begin{DndComment}{About This Bestiary}
This bestiary contains <# creature_count #> creatures<@ if sources_used @> from <# sources_used | join(", ") #><@ endif @>.

<@ if cr_summary @>
\textbf{Challenge Ratings:} <# cr_summary #>
<@ endif @>

<@ if type_summary @>
\textbf{Creature Types:} <# type_summary #>
<@ endif @>
\end{DndComment}

\vspace{1em}
<@ endif @>

<#-- Main bestiary content organized by groups --#>
<@ if creatures_by_group @>
<@ for group_name, creature_list in creatures_by_group.items() @>

<#-- Group header --#>
\section{<# group_name | latex_escape #>}

\vspace{0.5em}

<#-- Creatures in this group --#>
<@ for creature in creature_list @>
<@ if show_creature_table_of_contents @>
\addcontentsline{toc}{subsection}{<# creature.name | latex_escape #>}
<@ endif @>

<#-- Use shared creature rendering macro for consistency --#>
<# render_creature(creature) #>

<#-- Add float barrier every 10 creatures to prevent accumulation --#>
<@ if loop.index % 10 == 0 and not loop.last @>
\FloatBarrier
<@ endif @>

<@ if not loop.last @>
\vspace{1.2em}
<@ endif @>
<@ endfor @>

<@ if not loop.last @>
\vspace{2em}
<@ endif @>

<#-- Add float barrier at end of each group --#>
\FloatBarrier
<@ endfor @>

<@ else @>
<#-- Fallback: render creatures without grouping --#>
\section{Creatures}

<@ for creature in creatures @>
<@ if show_creature_table_of_contents @>
\addcontentsline{toc}{subsection}{<# creature.name | latex_escape #>}
<@ endif @>

<#-- Use shared creature rendering macro for consistency --#>
<# render_creature(creature) #>

<#-- Add float barrier every 10 creatures to prevent accumulation --#>
<@ if loop.index % 10 == 0 and not loop.last @>
\FloatBarrier
<@ endif @>

<@ if not loop.last @>
\vspace{1.2em}
<@ endif @>
<@ endfor @>
<@ endif @>

<@ endblock @>
