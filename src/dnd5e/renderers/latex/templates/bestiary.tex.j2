% Bestiary template for D&D 5e creatures with grouping support
% Uses dndbook document class with structured creature organization

<@ extends "base.tex.j2" @>

<@ block document_packages @>
<# super() #>

% Additional packages for bestiary layout
\usepackage{multicol}
\usepackage{enumitem}
\usepackage{tcolorbox}
\usepackage{titlesec}

% Enhanced list environments for creature details
\tcbuselibrary{breakable}

% Float management for large bestiaries
\usepackage{afterpage}
\usepackage{placeins}
<@ endblock @>

<@ block document_config @>
<# super() #>

% Enhanced section styling for bestiary
% DND-5e-LaTeX-Template provides all styling automatically

% Configure for bestiary structure
\setcounter{secnumdepth}{0}  % No section numbers for cleaner look
\setcounter{tocdepth}{2}     % Include subsections in table of contents
<@ endblock @>

<@ block table_of_contents @>
<@ if show_creature_table_of_contents @>
\tableofcontents
\clearpage
<@ endif @>
<@ endblock @>

<@ block document_structure @>
<#-- Bestiary introduction with summary --#>
<@ if creature_count > 0 @>
\begin{DndComment}{About This Bestiary}
This bestiary contains <# creature_count #> creatures<@ if sources_used @> from <# sources_used | join(", ") #><@ endif @>.

<@ if cr_summary @>
\textbf{Challenge Ratings:} <# cr_summary #>
<@ endif @>

<@ if type_summary @>
\textbf{Creature Types:} <# type_summary #>
<@ endif @>
\end{DndComment}

\vspace{1em}
<@ endif @>

<#-- Main bestiary content organized by groups --#>
<@ if creatures_by_group @>
<@ for group_name, creature_list in creatures_by_group.items() @>

<#-- Group header --#>
\section{<# group_name | latex_escape #>}

\vspace{0.5em}

<#-- Creatures in this group --#>
<@ for creature in creature_list @>
<@ if show_creature_table_of_contents @>
\addcontentsline{toc}{subsection}{<# creature.name | latex_escape #>}
<@ endif @>

<#-- Check if creature needs full-width layout --#>
<@ if creature.requires_full_width_layout() @>
% Large creature - switch to single column layout
\onecolumn
<@ endif @>

<#-- Render using DndMonster environment with proper float placement --#>
\begin{DndMonster}[float=htbp]{<# creature.name | latex_escape #>}
\noindent \DndMonsterType{<# creature.get_size_type_alignment() | latex_escape #>}
\DndMonsterBasics[
    armor-class = {<# creature.get_processed_ac_text() | safe #>},
    hit-points = {<# creature.get_hp_text() | latex_escape #>},
    speed = {<# creature.get_speed_text() | latex_escape #>}
]
\DndMonsterAbilityScores[
    str = <# creature.strength #>,
    dex = <# creature.dexterity #>,
    con = <# creature.constitution #>,
    int = <# creature.intelligence #>,
    wis = <# creature.wisdom #>,
    cha = <# creature.charisma #>
]

<@ if creature.get_formatted_saving_throws() or creature.get_formatted_skills() or creature.get_formatted_resistances() or creature.get_formatted_immunities() or creature.get_formatted_vulnerabilities() or creature.get_formatted_condition_immunities() or creature.get_formatted_senses() or creature.get_formatted_languages() @>
\DndMonsterDetails[
<@ if creature.get_formatted_saving_throws() @>    saving-throws = {<# creature.get_formatted_saving_throws() | latex_escape #>},
<@ endif @>
<@ if creature.get_formatted_skills() @>    skills = {<# creature.get_formatted_skills() | latex_escape #>},
<@ endif @>
<@ if creature.get_formatted_resistances() @>    damage-resistances = {<# creature.get_formatted_resistances() | latex_escape #>},
<@ endif @>
<@ if creature.get_formatted_immunities() @>    damage-immunities = {<# creature.get_formatted_immunities() | latex_escape #>},
<@ endif @>
<@ if creature.get_formatted_vulnerabilities() @>    damage-vulnerabilities = {<# creature.get_formatted_vulnerabilities() | latex_escape #>},
<@ endif @>
<@ if creature.get_formatted_condition_immunities() @>    condition-immunities = {<# creature.get_formatted_condition_immunities() | latex_escape #>},
<@ endif @>
<@ if creature.get_formatted_senses() @>    senses = {<# creature.get_processed_senses() | safe #>},
<@ endif @>
<@ if creature.get_formatted_languages() @>    languages = {<# creature.get_formatted_languages() | latex_escape #>},
<@ endif @>
    challenge = {<# creature.get_enhanced_cr_text() | latex_escape #>}
]
<@ endif @>

<@ if creature.trait @>
<@ for trait in creature.trait @>
\DndMonsterAction{<# trait.get_processed_name() | safe #>}
<# trait.get_description_text() | safe #>

<@ endfor @>
<@ endif @>

<@ if creature.action @>
<@ for action in creature.action @>
\DndMonsterAction{<# action.get_processed_name() | safe #>}
<# action.get_description_text() | safe #>

<@ endfor @>
<@ endif @>

<@ if creature.legendary @>
\DndMonsterSection{Legendary Actions}
<@ for legendary in creature.legendary @>
\DndMonsterAction{<# legendary.get_processed_name() | safe #>}
<# legendary.get_description_text() | safe #>

<@ endfor @>
<@ endif @>

<@ if creature.reaction @>
\DndMonsterSection{Reactions}
<@ for reaction in creature.reaction @>
\DndMonsterAction{<# reaction.get_processed_name() | safe #>}
<# reaction.get_description_text() | safe #>

<@ endfor @>
<@ endif @>

<@ if creature.bonus @>
\DndMonsterSection{Bonus Actions}
<@ for bonus in creature.bonus @>
\DndMonsterAction{<# bonus.get_processed_name() | safe #>}
<# bonus.get_description_text() | safe #>

<@ endfor @>
<@ endif @>

\end{DndMonster}

<@ if creature.requires_full_width_layout() @>
% Switch back to two column layout
\twocolumn
<@ endif @>

<#-- Add float barrier every 10 creatures to prevent accumulation --#>
<@ if loop.index % 10 == 0 and not loop.last @>
\FloatBarrier
<@ endif @>

<@ if not loop.last @>
\vspace{1.2em}
<@ endif @>
<@ endfor @>

<@ if not loop.last @>
\vspace{2em}
<@ endif @>

<#-- Add float barrier at end of each group --#>
\FloatBarrier
<@ endfor @>

<@ else @>
<#-- Fallback: render creatures without grouping --#>
\section{Creatures}

<@ for creature in creatures @>
<@ if show_creature_table_of_contents @>
\addcontentsline{toc}{subsection}{<# creature.name | latex_escape #>}
<@ endif @>

<#-- Check if creature needs full-width layout --#>
<@ if creature.requires_full_width_layout() @>
% Large creature - switch to single column layout
\onecolumn
<@ endif @>

<#-- Render using DndMonster environment with proper float placement --#>
\begin{DndMonster}[float=htbp]{<# creature.name | latex_escape #>}
\DndMonsterType{<# creature.get_size_type_alignment() | latex_escape #>}
\DndMonsterBasics[
    armor-class = {<# creature.get_processed_ac_text() | safe #>},
    hit-points = {<# creature.get_hp_text() | latex_escape #>},
    speed = {<# creature.get_speed_text() | latex_escape #>}
]
\DndMonsterAbilityScores[
    str = <# creature.strength #>,
    dex = <# creature.dexterity #>,
    con = <# creature.constitution #>,
    int = <# creature.intelligence #>,
    wis = <# creature.wisdom #>,
    cha = <# creature.charisma #>
]

<@ if creature.get_formatted_saving_throws() or creature.get_formatted_skills() or creature.get_formatted_resistances() or creature.get_formatted_immunities() or creature.get_formatted_vulnerabilities() or creature.get_formatted_condition_immunities() or creature.get_formatted_senses() or creature.get_formatted_languages() @>
\DndMonsterDetails[
<@ if creature.get_formatted_saving_throws() @>    saving-throws = {<# creature.get_formatted_saving_throws() | latex_escape #>},
<@ endif @>
<@ if creature.get_formatted_skills() @>    skills = {<# creature.get_formatted_skills() | latex_escape #>},
<@ endif @>
<@ if creature.get_formatted_resistances() @>    damage-resistances = {<# creature.get_formatted_resistances() | latex_escape #>},
<@ endif @>
<@ if creature.get_formatted_immunities() @>    damage-immunities = {<# creature.get_formatted_immunities() | latex_escape #>},
<@ endif @>
<@ if creature.get_formatted_vulnerabilities() @>    damage-vulnerabilities = {<# creature.get_formatted_vulnerabilities() | latex_escape #>},
<@ endif @>
<@ if creature.get_formatted_condition_immunities() @>    condition-immunities = {<# creature.get_formatted_condition_immunities() | latex_escape #>},
<@ endif @>
<@ if creature.get_formatted_senses() @>    senses = {<# creature.get_processed_senses() | safe #>},
<@ endif @>
<@ if creature.get_formatted_languages() @>    languages = {<# creature.get_formatted_languages() | latex_escape #>},
<@ endif @>
    challenge = {<# creature.get_enhanced_cr_text() | latex_escape #>}
]
<@ endif @>

<@ if creature.trait @>
<@ for trait in creature.trait @>
\DndMonsterAction{<# trait.get_processed_name() | safe #>}
<# trait.get_description_text() | safe #>

<@ endfor @>
<@ endif @>

<@ if creature.action @>
<@ for action in creature.action @>
\DndMonsterAction{<# action.get_processed_name() | safe #>}
<# action.get_description_text() | safe #>

<@ endfor @>
<@ endif @>

<@ if creature.legendary @>
\DndMonsterSection{Legendary Actions}
<@ for legendary in creature.legendary @>
\DndMonsterAction{<# legendary.get_processed_name() | safe #>}
<# legendary.get_description_text() | safe #>

<@ endfor @>
<@ endif @>

<@ if creature.reaction @>
\DndMonsterSection{Reactions}
<@ for reaction in creature.reaction @>
\DndMonsterAction{<# reaction.get_processed_name() | safe #>}
<# reaction.get_description_text() | safe #>

<@ endfor @>
<@ endif @>

<@ if creature.bonus @>
\DndMonsterSection{Bonus Actions}
<@ for bonus in creature.bonus @>
\DndMonsterAction{<# bonus.get_processed_name() | safe #>}
<# bonus.get_description_text() | safe #>

<@ endfor @>
<@ endif @>

\end{DndMonster}

<@ if creature.requires_full_width_layout() @>
% Switch back to two column layout
\twocolumn
<@ endif @>

<#-- Add float barrier every 10 creatures to prevent accumulation --#>
<@ if loop.index % 10 == 0 and not loop.last @>
\FloatBarrier
<@ endif @>

<@ if not loop.last @>
\vspace{1.2em}
<@ endif @>
<@ endfor @>
<@ endif @>

<@ endblock @>
