// Lark grammar for D&D 5e.tools tag parsing

?start: document

document: (text | tag)*

// Main tag structure
tag: "{@" tag_type tag_content "}"

tag_type: WORD

tag_content: content_part (pipe_separated_content)*

pipe_separated_content: "|" content_part

content_part: (TEXT | nested_tag | escaped_char)*

nested_tag: tag

// Text and content (simplified)
text: TEXT+

// Escaped characters
escaped_char: ESCAPED_PIPE | ESCAPED_BRACE

// Terminals
ESCAPED_PIPE: "\\|"
ESCAPED_BRACE: "\\}"
TEXT: /(?:[^{}|\\]|{(?![@#}])[^}]*}|{#[^}]*}|\\[{}|])+/
WORD: /\w+/

%import common.WS
%ignore WS
