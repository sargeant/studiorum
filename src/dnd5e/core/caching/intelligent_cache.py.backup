"""Intelligent multi-level caching system with usage pattern analysis."""

import asyncio
import time
import weakref
from collections import OrderedDict, defaultdict
from dataclasses import dataclass, field
from datetime import datetime, timedelta
from enum import Enum
from typing import Any

from ..optimization.memory_manager import MemoryPressureLevel


class CacheStrategy(Enum):
    """Intelligent caching strategies based on usage patterns."""
    LAZY_LOAD = "lazy_load"           # Load on first access
    PREDICTIVE = "predictive"         # Load based on usage patterns
    AGGRESSIVE = "aggressive"         # Pre-load frequently used content
    MEMORY_CONSCIOUS = "memory_conscious"  # Prioritize memory efficiency


class CacheLevel(Enum):
    """Multi-level cache hierarchy."""
    L1_MEMORY = "l1_memory"        # Hot frequently accessed
    L2_COMPRESSED = "l2_compressed" # Less frequent, compressed
    L3_DISK = "l3_disk"            # Persistent cache on disk


@dataclass
class ContentUsageStats:
    """Track content usage patterns for intelligent caching."""
    access_count: int = 0
    last_accessed: datetime | None = None
    search_frequency: float = 0.0  # requests per hour
    context_correlation: dict[str, int] = field(default_factory=dict)
    memory_size_bytes: int = 0
    load_time_ms: float = 0.0

    def update_access(self) -> None:
        """Update access statistics."""
        self.access_count += 1
        now = datetime.now()
        self.last_accessed = now

        # Update frequency (simple exponential moving average)
        if self.access_count > 1:
            time_diff_hours = 1.0  # Simplified calculation
            self.search_frequency = (self.search_frequency * 0.9) + (1.0 / time_diff_hours * 0.1)


@dataclass
class CacheConfiguration:
    """Advanced cache configuration with performance tuning."""
    max_memory_mb: int = 500
    max_items: int = 10000
    ttl_base_minutes: int = 60
    predictive_threshold: int = 5  # Access count before predictive loading
    memory_pressure_threshold: float = 0.8  # Trigger cleanup at 80% memory
    concurrent_loads: int = 5  # Max concurrent async content loads
    cache_strategy: CacheStrategy = CacheStrategy.LAZY_LOAD
    enable_usage_analytics: bool = True


@dataclass
class CacheEntry:
    """Enhanced cache entry with intelligence metadata."""
    content_id: str
    content: Any
    cached_at: float
    access_count: int = 0
    last_accessed: float = 0
    access_frequency: float = 0  # accesses per hour
    context_correlations: dict[str, int] = field(default_factory=dict)
    memory_size: int = 0
    compression_ratio: float = 1.0
    cache_level: CacheLevel = CacheLevel.L1_MEMORY

    def __post_init__(self) -> None:
        """Initialize timestamps."""
        if self.last_accessed == 0:
            self.last_accessed = self.cached_at

    @property
    def cache_value_score(self) -> float:
        """Calculate cache value for eviction prioritization."""
        age_penalty = (time.time() - self.last_accessed) / 3600  # Hours since access
        frequency_bonus = self.access_frequency * 10
        correlation_bonus = len(self.context_correlations) * 2
        size_penalty = self.memory_size / (1024 * 1024)  # MB penalty

        return frequency_bonus + correlation_bonus - age_penalty - size_penalty

    def record_access(self) -> None:
        """Record an access to this cache entry."""
        self.access_count += 1
        current_time = time.time()
        self.last_accessed = current_time

        # Update access frequency (simple moving average)
        if self.access_count > 1:
            time_diff_hours = max((current_time - self.cached_at) / 3600, 0.01)
            self.access_frequency = self.access_count / time_diff_hours


class IntelligentMultiLevelCache:
    """Multi-level cache with usage pattern analysis."""

    def __init__(self, config: CacheConfiguration):
        self.config = config

        # Single-level cache for now (L1 memory cache)
        # Multi-level will be added in Phase 2
        self.l1_cache: dict[str, CacheEntry] = {}

        # Intelligence tracking
        self.access_patterns: dict[str, list[float]] = defaultdict(list)  # access timestamps
        self.context_graph: dict[str, dict[str, int]] = defaultdict(dict)  # content correlation
        self.usage_predictions: dict[str, float] = {}  # predicted next access time

        # Performance monitoring
        self.cache_stats = {
            "l1_hits": 0, "l1_misses": 0,
            "l2_hits": 0, "l2_misses": 0,
            "l3_hits": 0, "l3_misses": 0,
            "evictions": 0, "promotions": 0, "demotions": 0
        }

        # Background cleanup task
        self._cleanup_task: asyncio.Task | None = None

    async def start_background_tasks(self) -> None:
        """Start background cache maintenance tasks."""
        if not self._cleanup_task:
            self._cleanup_task = asyncio.create_task(self._background_cleanup_loop())

    async def stop_background_tasks(self) -> None:
        """Stop background tasks and cleanup."""
        if self._cleanup_task:
            self._cleanup_task.cancel()
            try:
                await self._cleanup_task
            except asyncio.CancelledError:
                pass
            self._cleanup_task = None

    async def cleanup(self) -> None:
        """Cleanup all resources."""
        await self.stop_background_tasks()
        self.l1_cache.clear()
        self.access_patterns.clear()
        self.context_graph.clear()
        self.usage_predictions.clear()

    async def get(
        self,
        content_id: str,
        context: Any | None = None  # Will be properly typed when context is available
    ) -> Any | None:
        """Multi-level cache retrieval with promotion/demotion."""

        # L1 Memory cache (fastest)
        if content_id in self.l1_cache:
            entry = self.l1_cache[content_id]
            entry.record_access()
            self._record_context_access(content_id, context)
            self.cache_stats["l1_hits"] += 1
            return entry.content

        # L2 and L3 will be implemented in Phase 2

        # Cache miss
        self.cache_stats["l1_misses"] += 1
        return None

    async def put(
        self,
        content_id: str,
        content: Any,
        context: Any | None = None
    ) -> None:
        """Intelligent cache storage with level assignment."""

        # Calculate content metadata
        memory_size = self._estimate_content_size(content)
        entry = CacheEntry(
            content_id=content_id,
            content=content,
            cached_at=time.time(),
            memory_size=memory_size,
            cache_level=CacheLevel.L1_MEMORY
        )

        # Store in L1 for now (multi-level in Phase 2)
        await self._store_in_l1(entry)

        # Update context correlations
        if context:
            self._update_context_correlations(content_id, context)

    async def _store_in_l1(self, entry: CacheEntry) -> None:
        """Store in L1 memory cache with eviction management."""

        # Check memory pressure and evict if necessary
        while self._get_l1_memory_usage() > self.config.max_memory_mb * 0.7:
            await self._evict_from_l1()

        # Check item limit
        while len(self.l1_cache) >= self.config.max_items:
            await self._evict_from_l1()

        self.l1_cache[entry.content_id] = entry

    async def _evict_from_l1(self) -> None:
        """Intelligent L1 eviction based on cache value scores."""

        if not self.l1_cache:
            return

        # Find least valuable entries
        entries_by_value = sorted(
            self.l1_cache.values(),
            key=lambda e: e.cache_value_score
        )

        # Evict lowest value entries
        evict_count = max(1, len(self.l1_cache) // 10)  # Evict 10%
        for entry in entries_by_value[:evict_count]:
            content_id = entry.content_id

            # Remove from L1
            self.l1_cache.pop(content_id, None)
            self.cache_stats["evictions"] += 1

    def _record_context_access(self, content_id: str, context: Any | None) -> None:
        """Record context access for correlation analysis."""
        if not context:
            return

        # Record access pattern
        self.access_patterns[content_id].append(time.time())

        # Limit access pattern history
        if len(self.access_patterns[content_id]) > 100:
            self.access_patterns[content_id] = self.access_patterns[content_id][-50:]

    def _update_context_correlations(self, content_id: str, context: Any) -> None:
        """Update context correlation data for predictive loading."""
        if not context or not self.config.enable_usage_analytics:
            return

        # This will be enhanced when context types are available
        # For now, just track basic correlation
        context_id = str(id(context))
        self.context_graph[content_id][context_id] = self.context_graph[content_id].get(context_id, 0) + 1

    def _estimate_content_size(self, content: Any) -> int:
        """Estimate memory size of content object."""
        try:
            import sys
            return sys.getsizeof(content)
        except Exception:
            # Fallback estimation
            if isinstance(content, str):
                return len(content.encode('utf-8'))
            elif isinstance(content, list | tuple):
                return sum(self._estimate_content_size(item) for item in content[:10])  # Sample first 10
            elif isinstance(content, dict):
                return sum(
                    self._estimate_content_size(k) + self._estimate_content_size(v)
                    for k, v in list(content.items())[:10]  # Sample first 10
                )
            else:
                return 1024  # Default 1KB estimate

    def _get_l1_memory_usage(self) -> float:
        """Get current L1 cache memory usage in MB."""
        total_size = sum(entry.memory_size for entry in self.l1_cache.values())
        return total_size / (1024 * 1024)

    async def _background_cleanup_loop(self) -> None:
        """Background cache cleanup based on usage patterns and memory pressure."""
        while True:
            try:
                await asyncio.sleep(300)  # Run every 5 minutes

                current_time = time.time()
                expired_entries = []

                # Find expired entries
                for content_id, entry in self.l1_cache.items():
                    # TTL-based expiration with usage-based extension
                    base_ttl_seconds = self.config.ttl_base_minutes * 60

                    # Extend TTL for frequently accessed content
                    if entry.access_count > 10:
                        base_ttl_seconds *= 2  # Double TTL for popular content

                    if current_time - entry.cached_at > base_ttl_seconds:
                        expired_entries.append(content_id)

                # Remove expired content
                for content_id in expired_entries:
                    self.l1_cache.pop(content_id, None)

            except asyncio.CancelledError:
                break
            except Exception:
                # Log but continue cleanup loop
                pass

    async def clear_expired(self) -> int:
        """Clear expired cache entries."""
        current_time = time.time()
        base_ttl_seconds = self.config.ttl_base_minutes * 60
        expired_entries = []

        for content_id, entry in self.l1_cache.items():
            if current_time - entry.cached_at > base_ttl_seconds:
                expired_entries.append(content_id)

        for content_id in expired_entries:
            self.l1_cache.pop(content_id, None)

        return len(expired_entries)

    async def emergency_cleanup(self, eviction_ratio: float = 0.5) -> int:
        """Emergency cache cleanup for memory pressure."""
        target_evict = int(len(self.l1_cache) * eviction_ratio)

        if target_evict <= 0:
            return 0

        # Sort by cache value score (lowest first)
        entries_by_value = sorted(
            self.l1_cache.items(),
            key=lambda item: item[1].cache_value_score
        )

        # Evict lowest value entries
        evicted_count = 0
        for content_id, entry in entries_by_value[:target_evict]:
            self.l1_cache.pop(content_id, None)
            evicted_count += 1

        self.cache_stats["evictions"] += evicted_count
        return evicted_count

    async def clear(self) -> None:
        """Clear all cache entries."""
        self.l1_cache.clear()
        self.access_patterns.clear()
        self.context_graph.clear()
        self.usage_predictions.clear()

    def get_statistics(self) -> dict[str, Any]:
        """Get comprehensive cache statistics."""
        total_requests = self.cache_stats["l1_hits"] + self.cache_stats["l1_misses"]
        hit_rate = self.cache_stats["l1_hits"] / total_requests if total_requests > 0 else 0.0

        return {
            "config": {
                "max_memory_mb": self.config.max_memory_mb,
                "max_items": self.config.max_items,
                "cache_strategy": self.config.cache_strategy.value,
            },
            "usage": {
                "cached_items": len(self.l1_cache),
                "memory_usage_mb": self._get_l1_memory_usage(),
                "hit_rate": hit_rate,
                "total_requests": total_requests,
            },
            "stats": self.cache_stats,
            "top_content": [
                {
                    "content_id": content_id[:50],  # Truncate for display
                    "access_count": entry.access_count,
                    "cache_value_score": entry.cache_value_score,
                }
                for content_id, entry in sorted(
                    self.l1_cache.items(),
                    key=lambda item: item[1].access_count,
                    reverse=True
                )[:10]
            ]
        }
