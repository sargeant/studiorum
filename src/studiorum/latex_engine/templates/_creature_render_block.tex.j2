% Shared creature rendering block for use in both bestiary and creature_entry templates
% This macro can be included by both templates to ensure consistent rendering

<@ from "_entry_macros.tex.j2" import smart_render_entry with context @>

<#--
  Helper macros to reduce duplication and improve readability.
  These do not change behavior; they centralize repeated rendering patterns
  for spellcasting blocks and named entries, and gate section headers.
--#>

<#--
  Macro: render_spellcasting_block(spellcasting)
  Purpose: Render a spellcasting block as a DndMonsterAction heading,
           followed by structured content via smart_render_entry with
           renderHeader=False (header already printed by the action line).
  Requires: engine-injected entry_processor and rendering_context.
--#>
<@ macro render_spellcasting_block(spellcasting) @>
\DndMonsterAction{<# spellcasting | safe_processed_name | safe #>}
<# smart_render_entry({
    'type': 'spellcasting',
    'name': spellcasting.name,
    'headerEntries': spellcasting.headerEntries,
    'footerEntries': spellcasting.footerEntries,
    'spells': spellcasting.spells,
    'will': spellcasting.will,
    'daily': spellcasting.daily,
    'renderHeader': False
}, entry_processor, rendering_context) #>

<@ endmacro @>

<#--
  Macro: render_named_entry(entry)
  Purpose: Print the entry name as a DndMonsterAction heading and render
           either entry.entries (if present) or the entry itself.
  Notes:   Keeps behavior identical to prior inline branches.
--#>
<@ macro render_named_entry(entry) @>
\DndMonsterAction{<# entry | safe_processed_name | safe #>}
<@ if entry.entries is defined and entry.entries @>
<# smart_render_entry(entry.entries, entry_processor, rendering_context) #>
<@ else @>
<# smart_render_entry(entry, entry_processor, rendering_context) #>
<@ endif @>

<@ endmacro @>

<#--
  Macro: render_section(title, entries_list, spell_list)
  Purpose: Conditionally render a section header when content exists, then
           render any spellcasting blocks followed by named entries.
  Params:  title (string), entries_list (list or None), spell_list (list or None)
--#>
<@ macro render_section(title, entries_list, spell_list) @>
<@ if (entries_list) or (spell_list) @>
\DndMonsterSection{<# title #>}
<@ for spellcasting in (spell_list or []) @>
<# render_spellcasting_block(spellcasting) #>

<@ endfor @>
<@ if entries_list @>
<@ for entry in entries_list @>
<# render_named_entry(entry) #>

<@ endfor @>
<@ endif @>
<@ endif @>
<@ endmacro @>

<#-- Legendary Actions handled via render_section helper. --#>

<#--
  Macro: render_lair_actions_section(lair_actions)
  Purpose: Render the Lair Actions section; supports both raw string entries
           and objects with optional names + entries.
  Notes:   Matches previous special-casing for string lair actions.
--#>
<@ macro render_lair_actions_section(lair_actions) @>
<@ if lair_actions @>
\DndMonsterSection{Lair Actions}
<@ for lair_action in lair_actions @>
<@ if lair_action is string @>
<# smart_render_entry(lair_action, entry_processor, rendering_context) #>

<@ else @>
<@ if lair_action | safe_processed_name @>
\DndMonsterAction{<# lair_action | safe_processed_name | safe #>}
<@ endif @>
<@ if lair_action.entries is defined and lair_action.entries @>
<# smart_render_entry(lair_action.entries, entry_processor, rendering_context) #>
<@ else @>
<# smart_render_entry(lair_action, entry_processor, rendering_context) #>
<@ endif @>

<@ endif @>
<@ endfor @>
<@ endif @>
<@ endmacro @>

<#--
  Macro: render_creature(creature, template_service, content_tracker, latex_config)
  Purpose: Top-level creature renderer. Sets up wide/narrow DndMonster layout,
           prints core fields (type, basics, ability scores, details), and then
           delegates sections to helper macros. Honors modern statblock save
           placement and wide layout multicols configuration.
  Inputs:  creature (object with accessors), latex_config (for statblock mode).
  Requires: engine-injected entry_processor and rendering_context.
--#>
<@ macro render_creature(creature, template_service=template_service, content_tracker=content_tracker, latex_config=latex_config) @>
<@ set needs_full_width = creature.requires_full_width_layout() @>

<#-- Render using DndMonster environment with proper float placement --#>
<@ if needs_full_width @>
\begin{DndMonster}[float*=tp,width=\textwidth + 8pt, title to upper=0pt, top=1pt]{<# creature.name | latex_escape #>}
\vspace*{-1.8\baselineskip}
\begin{multicols}{2}
\raggedcolumns
\begingroup
\setlength{\premulticols}{0pt}
\setlength{\postmulticols}{0pt}
\setlength{\multicolsep}{0pt}
\setlength{\parskip}{0pt}
<@ else @>
\begin{DndMonster}[float=tp]{<# creature.name | latex_escape #>}
<@ endif @>
\noindent \DndMonsterType{<# creature.get_size_type_alignment() | latex_escape #>}
\DndMonsterBasics[
    armor-class = {<# creature.get_processed_ac_text() | safe #>},
    hit-points = {<# creature.get_hp_text() | latex_escape #>},
    speed = {<# creature.get_speed_text() | latex_escape #>},
    initiative = <@ if creature.get_initiative_modifier() >= 0 @>+<@ endif @><# creature.get_initiative_modifier() #>
]
<#-- Check if using modern statblock format --#>
<@ set is_modern = latex_config and latex_config.document and latex_config.document.statblock in ['2024', 'modern'] @>
\DndMonsterAbilityScores[
    str = <# creature.strength #>,
    dex = <# creature.dexterity #>,
    con = <# creature.constitution #>,
    int = <# creature.intelligence #>,
    wis = <# creature.wisdom #>,
    cha = <# creature.charisma #><@ if is_modern @>,
<@ if creature.get_save_value('str') is not none @>    str save = <@ if creature.get_save_value('str') >= 0 @>+<@ endif @><# creature.get_save_value('str') #>,
<@ endif @><@ if creature.get_save_value('dex') is not none @>    dex save = <@ if creature.get_save_value('dex') >= 0 @>+<@ endif @><# creature.get_save_value('dex') #>,
<@ endif @><@ if creature.get_save_value('con') is not none @>    con save = <@ if creature.get_save_value('con') >= 0 @>+<@ endif @><# creature.get_save_value('con') #>,
<@ endif @><@ if creature.get_save_value('int') is not none @>    int save = <@ if creature.get_save_value('int') >= 0 @>+<@ endif @><# creature.get_save_value('int') #>,
<@ endif @><@ if creature.get_save_value('wis') is not none @>    wis save = <@ if creature.get_save_value('wis') >= 0 @>+<@ endif @><# creature.get_save_value('wis') #>,
<@ endif @><@ if creature.get_save_value('cha') is not none @>    cha save = <@ if creature.get_save_value('cha') >= 0 @>+<@ endif @><# creature.get_save_value('cha') #>
<@ endif @><@ endif @>
]

<#-- Only show DndMonsterDetails if there's something to show (excluding saves in modern format) --#>
<@ if (not is_modern and creature.get_formatted_saving_throws()) or creature.get_formatted_skills() or creature.get_formatted_resistances() or creature.get_formatted_immunities() or creature.get_formatted_vulnerabilities() or creature.get_formatted_condition_immunities() or creature.get_formatted_senses() or creature.get_formatted_languages() @>
\DndMonsterDetails[
<#-- Only include saving-throws in classic format --#>
<@ if not is_modern and creature.get_formatted_saving_throws() @>    saving-throws = {<# creature.get_formatted_saving_throws() | latex_escape #>},
<@ endif @>
<@ if creature.get_formatted_skills() @>    skills = {<# creature.get_formatted_skills() | latex_escape #>},
<@ endif @>
<@ if creature.get_formatted_resistances() @>    damage-resistances = {<# creature.get_formatted_resistances() | latex_escape #>},
<@ endif @>
<@ if creature.get_formatted_immunities() @>    damage-immunities = {<# creature.get_formatted_immunities() | latex_escape #>},
<@ endif @>
<@ if creature.get_formatted_vulnerabilities() @>    damage-vulnerabilities = {<# creature.get_formatted_vulnerabilities() | latex_escape #>},
<@ endif @>
<@ if creature.get_formatted_condition_immunities() @>    condition-immunities = {<# creature.get_formatted_condition_immunities() | latex_escape #>},
<@ endif @>
<@ if creature.get_formatted_senses() @>    senses = {<# creature.get_processed_senses() | safe #>},
<@ endif @>
<@ if creature.get_formatted_languages() @>    languages = {<# creature.get_formatted_languages() | latex_escape #>},
<@ endif @>    challenge = {<# creature.get_enhanced_cr_text() | latex_escape #>}
]
<@ endif @>

<@ set traits_spellcasting = [] @>
<@ if creature.spellcasting @>
<@ for spellcasting in creature.spellcasting @>
<@ if not spellcasting.displayAs @>
<@ set _ = traits_spellcasting.append(spellcasting) @>
<@ endif @>
<@ endfor @>
<@ endif @>

<# render_section('Traits', creature.trait, traits_spellcasting) #>

<@ set action_spells = [] @>
<@ set bonus_spells = [] @>
<@ set reaction_spells = [] @>
<@ if creature.spellcasting @>
<@ for spellcasting in creature.spellcasting @>
<@ if spellcasting.displayAs == "action" @>
<@ set _ = action_spells.append(spellcasting) @>
<@ elif spellcasting.displayAs == "bonus" @>
<@ set _ = bonus_spells.append(spellcasting) @>
<@ elif spellcasting.displayAs == "reaction" @>
<@ set _ = reaction_spells.append(spellcasting) @>
<@ endif @>
<@ endfor @>
<@ endif @>

<# render_section('Actions', creature.action, action_spells) #>

<# render_section('Bonus Actions', creature.bonus, bonus_spells) #>

<# render_section('Reactions', creature.reaction, reaction_spells) #>

<# render_section('Legendary Actions', creature.legendary, None) #>

<# render_lair_actions_section(creature.lair_actions) #>

% Add source abbreviation at the bottom
\vspace{2pt}
\noindent\hfill{\scriptsize\textcolor{gray}{<# creature.source.abbreviation | latex_escape #>}}

<@ if needs_full_width @>
\endgroup
\end{multicols}
\end{DndMonster}
<@ else @>
\end{DndMonster}
<@ endif @>

<#-- no-op: multicols handled inside DndMonster for wide layout --#>
<@ endmacro @>
