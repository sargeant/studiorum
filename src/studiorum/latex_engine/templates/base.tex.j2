% Base LaTeX template for D&D 5e documents using DND-5e-LaTeX-Template
% This template provides the foundation for all D&D-style documents with structured content

<#-- Build document class line with options --#>
\documentclass[<# class_options | join(', ') #>]{<# document_class #>}

<#-- Document configuration --#>
<@ block document_packages @>
% DND-5e-LaTeX-Template provides most styling automatically
% Only include additional packages if needed


% Additional packages for enhanced functionality
\usepackage{graphicx}
\usepackage{wrapfig}
\usepackage{hyperref}
\usepackage{bookmark}
\usepackage{makeidx}

<@ if enable_index @>
\makeindex
<@ endif @>
<@ endblock @>

<#-- Document metadata --#>
<@ block document_metadata @>
<@ if metadata @>
\title{<# metadata.title #>}
<@ if metadata.subtitle @>
\subtitle{<# metadata.subtitle #>}
<@ endif @>
\date{\today}
<@ endif @>
<@ endblock @>

<#-- Additional configuration --#>
<@ block document_config @>
<@ if numbered_sections | default(true) @>
% Enable automatic numbering for chapters only, not sections
\setcounter{secnumdepth}{0}
<@ else @>
% Disable automatic section numbering while preserving TOC entries
\setcounter{secnumdepth}{-1}
<@ endif @>

<@ if not justified_text @>
% Disable text justification but preserve paragraph indentation
\raggedright
\raggedbottom
% Restore paragraph indentation after \raggedright resets it
\setlength{\parindent}{0.8em}
<@ endif @>

% Hyperlink configuration
\hypersetup{
    colorlinks=true,
    linkcolor=black,
    urlcolor=black,
    citecolor=black,
    filecolor=black,
    bookmarks=true,
    bookmarksopen=true,
    bookmarksnumbered=true,
    <@ if title @>
    pdftitle={<# title #>},
    <@ endif @>
    pdfsubject={D&D 5e Content},
    pdfkeywords={D&D, 5e, RPG, tabletop, }
}

<@ endblock @>

<#-- Studiorum image macros --#>
<@ include '_studiorum_image_macros.tex.j2' @>
<@ from '_chapters.tex.j2' import chapter_list @>

<#-- Document structure --#>
\begin{document}

<@ block document_header @>
<@ if use_frontmatter @>
\frontmatter
<@ endif @>

<@ if show_title_page @>
% Title page
\maketitle
\thispagestyle{empty}
<@ if use_frontmatter @>
\clearpage
<@ else @>
\newpage
<@ endif @>
<@ endif @>
<@ endblock @>

<@ block table_of_contents @>
<@ if show_toc or (metadata and metadata.include_toc) @>
<@ if use_frontmatter @>
% Table of Contents in frontmatter
<@ endif @>
\tableofcontents
\clearpage
<@ endif @>
<@ endblock @>

<@ block document_structure @>
<@ if use_frontmatter @>
\mainmatter
<@ endif @>

<@ if chapters is defined @>
<# chapter_list(chapters) #>
<@ endif @>
<@ endblock @>

<#-- appendices() runs after the body, so it sees every reference the body tracked --#>
<@ block appendices @>
<@ if appendices is defined @>
<# chapter_list(appendices(), appendix=chapters is defined and chapters | selectattr("opening", "equalto", "appendix") | list | length > 0) #>
<@ endif @>
<@ endblock @>

<@ block document_footer @>
<@ if use_frontmatter and (show_index or (metadata and metadata.include_index)) @>
\backmatter
<@ endif @>

<@ if show_index or (metadata and metadata.include_index) @>
\printindex
<@ endif @>

<@ endblock @>

\end{document}
