% Shared spell rendering block for use in both spellbook and spell_entry templates
% This macro can be included by both templates to ensure consistent rendering

<@ from "_entry_macros.tex.j2" import smart_render_entry with context @>

<@ macro render_spell(spell, template_service=template_service, content_tracker=content_tracker) @>
\DndSpellHeader%
  {<# spell.name | latex_escape #>}
  {<# spell.get_level_text() | latex_escape #>}
  {<# template_service.process_field_text(spell.get_casting_time_text()) | safe #>}
  {<# spell.get_range_text() | latex_escape #>}
  {<# spell.get_components_text() | latex_escape #>}
  {<# spell.get_duration_text() | latex_escape #>}

<@ if (spell is defined and spell is not string and spell.entries is defined and spell.entries) or (spell is sequence and spell is not string) @>
<# smart_render_entry(spell, entry_processor, rendering_context) #>
<@ elif description_text is defined and description_text @>
<# description_text | latex_escape #>
<@ else @>
<# '' #>
<@ endif @>

<@ if spell.higher_level @>
<@ for hl_entry in spell.higher_level @>

\paragraph{<# hl_entry.name | latex_escape #>} <# smart_render_entry(hl_entry, entry_processor, rendering_context) #>
<@ endfor @>
<@ endif @>
<@ endmacro @>
