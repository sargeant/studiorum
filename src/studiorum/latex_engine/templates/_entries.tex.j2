<#-- Environments for 5etools entries; entries.py fills them in with LaTeX, so every argument is | safe --#>

<#-- One list environment; label none is a plain \item, '' an empty label --#>
<@ macro list_env(env, items) @>
\begin{<# env #>}
<@ for label, body in items @>
\item<@ if label is none @> <@ elif label @>[<# label | safe #>] <@ else @>[\mbox{}] <@ endif @><# body | safe #>
<@ endfor @>
\end{<# env #>}
<@- endmacro @>

<#-- A DndTable; header is the escaped caption, spec the column specification.
     A wide table floats across both columns. --#>
<@ macro table(header, spec, labels, rows, wide=False) @>
<@ if wide @>
\begin{table*}[tp]
<@ endif @>
<@ if header and wide @>
\begin{DndTable}[header={<# header | safe #>},width=\textwidth]{<# spec | safe #>}
<@ elif header @>
\begin{DndTable}[header={<# header | safe #>}]{<# spec | safe #>}
<@ elif wide @>
\begin{DndTable}[width=\textwidth]{<# spec | safe #>}
<@ else @>
\begin{DndTable}{<# spec | safe #>}
<@ endif @>
<@ if labels and wide @>
<@ for label in labels @><# column_label(label) #><@ if not loop.last @> & <@ endif @><@ endfor @> \\
<@ elif labels @>
<# labels | join(' & ') | safe #> \\
<@ endif @>
<@ for row in rows @>
<# row | join(' & ') | safe #> \\
<@ endfor @>
\end{DndTable}
<@- if wide @>

\end{table*}
<@- endif @>
<@- endmacro @>

<#-- A wide table's plain label of several words, one word a line --#>
<@ macro column_label(label) @>
<@- if ' ' in label and '\\' not in label -@>
\shortstack{<# label.split(' ') | join('\\\\') | safe #>}
<@- else -@>
<# label | safe #>
<@- endif -@>
<@- endmacro @>

<#-- Lines 5etools sets as divs: flush left, one to a paragraph --#>
<@ macro flush_lines(lines) @>
<@ for line in lines @>
\noindent <# line | safe #>\par
<@ endfor @>
<@- endmacro @>

<@ macro read_aloud(body) @>
\begin{DndReadAloud}
<# body | safe #>
\end{DndReadAloud}
<@- endmacro @>

<@ macro sidebar(title, body) @>
\begin{DndSidebar}{<# title | safe #>}
<# body | safe #>
\end{DndSidebar}
<@- endmacro @>

<@ macro quote(body, by) @>
\begin{quotation}
\em
<# body | safe #>
<@ if by @>

\hfill --- <# by | safe #>
<@ endif @>
\end{quotation}
<@- endmacro @>

<@ macro monster_spells(lines) @>
\begin{DndMonsterSpells}
<@ for line in lines @>
<# line | safe #>
<@ endfor @>
\end{DndMonsterSpells}
<@- endmacro @>
