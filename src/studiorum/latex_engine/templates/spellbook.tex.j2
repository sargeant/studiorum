% Spellbook template for D&D 5e spells with level grouping
% Uses dndbook document class with structured spell organization

<@ extends "base.tex.j2" @>

<@ block document_packages @>
<# super() #>

% Additional packages for spellbook layout
\usepackage{multicol}
\usepackage{enumitem}
\usepackage{tcolorbox}
\usepackage{titlesec}

% Enhanced list environments for spell details
\tcbuselibrary{breakable}
<@ endblock @>

<@ block document_config @>
<# super() #>

% Enhanced section styling for spellbook
% DND-5e-LaTeX-Template provides all styling automatically

% Configure for spellbook structure
\setcounter{secnumdepth}{0}  % No section numbers for cleaner look
\setcounter{tocdepth}{2}     % Include subsections in table of contents
<@ endblock @>

<@ block table_of_contents @>
<@ if show_spell_table_of_contents @>
\tableofcontents
\clearpage
<@ endif @>
<@ endblock @>

<@ block document_structure @>
<#-- Spellbook introduction --#>

<@ from "_entry_macros.tex.j2" import smart_render_entry with context @>
<@ from "_spell_render_block.tex.j2" import render_spell with context @>

<#-- Main spellbook content organized by level --#>
<@ if spells_by_level @>
<@ for level, spell_list in spells_by_level.items() @>

<#-- Level header --#>
<@ if level == 0 @>
\section{Cantrips}
<@ elif level == 999 @>
\section{Spells}
<@ else @>
\section{<# ordinal(level) #> Level Spells}
<@ endif @>

\vspace{0.5em}

<#-- Spells in this level --#>
<@ for spell in spell_list @>
<@ if show_spell_table_of_contents @>
\addcontentsline{toc}{subsection}{<# spell.name | latex_escape #>}
<@ endif @>
<# render_spell(spell) #>

<@ if not loop.last @>
\vspace{0.8em}
<@ endif @>
<@ endfor @>

<@ if not loop.last @>
\vspace{1.5em}
<@ endif @>
<@ endfor @>

<@ else @>
<#-- Fallback: render spells without level grouping --#>
<@ for spell in spells @>
<@ if show_spell_table_of_contents @>
\addcontentsline{toc}{subsection}{<# spell.name | latex_escape #>}
<@ endif @>
<# render_spell(spell) #>

<@ if not loop.last @>
\vspace{1em}
<@ endif @>
<@ endfor @>
<@ endif @>

<@ endblock @>
