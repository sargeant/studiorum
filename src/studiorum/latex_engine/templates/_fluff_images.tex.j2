% Fluff image rendering macros
% Renders images extracted from fluff content for items, spells, and creatures

<#--
  Macro: render_fluff_images(content_name, fluff_images_map, entry_processor, context)
  Purpose: Render images associated with fluff content
  Params:  content_name - Name of the content item (e.g., item.name)
           fluff_images_map - Dictionary mapping names to lists of image info dicts
           entry_processor - The RecursiveEntryProcessor that contains the image processor
           context - The rendering context
--#>
<@ macro render_fluff_images(content_name, fluff_images_map, entry_processor, context) @>
<@ if fluff_images_map and content_name in fluff_images_map @>
<@ set images = fluff_images_map[content_name] @>
<@ if images @>
% Fluff images for <# content_name | latex_escape #>
<@ for image_info in images @>
<@ if image_info.path @>
<@- set enhanced_context = context.copy() -@>
<@- set _ = enhanced_context.metadata.update({
    'content_type': 'item',
    'layout_mode': 'twocolumn',
    'image_context': 'fluff_illustration',
    'item_name': content_name
}) -@>
<@- set image_entry = {
    'type': 'image',
    'href': {'type': 'internal', 'path': image_info.path},
    'title': image_info.title or content_name,
    'placement_hint': 'inline_small'
} -@>
<# entry_processor._image_processor.process_image_entry(image_entry, enhanced_context) #>
<@ endif @>
<@ endfor @>
<@ endif @>
<@ endif @>
<@ endmacro @>
